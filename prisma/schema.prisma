generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  refresh_token_expires_in Int?

  user User @relation(fields: [userId], references: [id])

  @@id([provider, providerAccountId])
}


model Comment {
  id         String   @id @default(cuid())
  postId     String
  userId     String?
  author     String?
  content    String
  createdAt  DateTime @default(now())
  sjhsUserId String?
  Post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  User       User?    @relation(fields: [userId], references: [id])
}

model Like {
  id         String  @id @default(cuid())
  postId     String
  userId     String?
  createdAt  DateTime @default(now())
  sjhsUserId String?
  Post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  User       User?    @relation(fields: [userId], references: [id])
}

model Board {
  id          String  @id @default(cuid())  // 게시판 ID
  name        String  // 게시판 이름
  description String? // 게시판 설명 (선택 사항)
  createdAt   DateTime @default(now())
  posts   Post[]

  @@unique([id, name])
}


model Post {
  id             String   @id @default(cuid())
  nickname       String?
  title          String
  content        String
  createdAt      DateTime  @default(now())
  image          String?
  video          String?
  authorId       String
  boardName      String 
  gradeTags      String[]  @default([])
  subSubjectTags String?
  subjectTags    String[]  @default([])
  type2          String[]  @default([])
  comments        Comment[]
  likes           Like[]  
  boardId         String  
  board  Board    @relation(fields: [boardId , boardName], references: [id , name])
  author               User      @relation(fields: [authorId], references: [id])
}


model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UnverifiedUser {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  nickname  String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
  handle    String?
  class     Int?
  grade     Int?
  image     String?
  role      String   @default("user")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime? @default(now())
  role          String    @default("user")
  class         Int?
  grade         Int?
  studentnumber Int?
  nickname      String?
  handle        String?
  password          String?
  providerId    String?
  verificationToken String?
  accounts      Account[]
  comments      Comment[]
  likes         Like[]
  posts         Post[]
  sessions      Session[]
}


